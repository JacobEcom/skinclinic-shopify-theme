{%- liquid
  assign s = section.settings
  assign blog = s.blog
  assign articles = blog.articles

  assign title_color = s.title_color | default: 'inherit'
  assign excerpt_color = s.excerpt_color | default: 'inherit'
  assign date_color = s.date_color | default: 'inherit'
  assign more_color = s.read_more_color | default: 'currentColor'
  assign card_bg = s.card_background | default: 'transparent'

  assign card_shadow = 'none'
  assign shadow_room_v = 0
  assign side_gap_final = s.side_gap
  if s.shadow_enabled
    assign shadow_color = s.shadow_color | default: '#000000'
    assign shadow_alpha = s.shadow_opacity | divided_by: 100.0
    assign shadow_rgba = shadow_color | color_modify: 'alpha', shadow_alpha
    assign card_shadow = s.shadow_x | append: 'px ' | append: s.shadow_y | append: 'px ' | append: s.shadow_blur | append: 'px ' | append: s.shadow_spread | append: 'px ' | append: shadow_rgba

    # How far the shadow reaches past the card edge, so it isn't clipped on any side.
    assign x_abs = s.shadow_x | abs
    assign y_abs = s.shadow_y | abs
    assign shadow_room = s.shadow_blur | plus: s.shadow_spread | plus: 8
    assign shadow_room_h = shadow_room | plus: x_abs
    assign shadow_room_v = shadow_room | plus: y_abs
    if s.side_gap == 0
      assign side_gap_final = shadow_room_h
    endif
  endif

  assign ratio = ''
  case s.image_height
    when '21 / 9'
      assign ratio = '21 / 9'
    when '3 / 1'
      assign ratio = '3 / 1'
    when '16 / 9'
      assign ratio = '16 / 9'
    when '3 / 2'
      assign ratio = '3 / 2'
    when '4 / 3'
      assign ratio = '4 / 3'
  endcase
-%}

{%- style -%}
  #bls-{{ section.id }} {
    --bls-card-gap: {{ s.card_gap }}px;
    --bls-card-pad: {{ s.card_padding }}px;
    --bls-card-radius: {{ s.card_radius }}px;
    --bls-card-bg: {{ card_bg }};
    --bls-text-max: {{ s.text_max_width }}%;
    --bls-title-color: {{ title_color }};
    --bls-title-size: {{ s.title_size }}px;
    --bls-excerpt-color: {{ excerpt_color }};
    --bls-date-color: {{ date_color }};
    --bls-more-color: {{ more_color }};
    --bls-shadow: {{ card_shadow }};
    --bls-side-gap: {{ side_gap_final }}px;
    --bls-shadow-room-v: {{ shadow_room_v }}px;
  }

  #bls-{{ section.id }}.bls-wrap {
    overflow-x: clip;
  }
  #bls-{{ section.id }} .bls {
    display: flex;
    flex-direction: column;
    gap: var(--bls-card-gap);
    padding-inline: var(--bls-side-gap);
    padding-block: var(--bls-shadow-room-v);
  }

  #bls-{{ section.id }} .bls__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--bls-card-radius);
    background: var(--bls-card-bg);
    box-shadow: var(--bls-shadow);
  }

  #bls-{{ section.id }} .bls__media {
    display: block;
    width: 100%;
    overflow: hidden;
  }
  #bls-{{ section.id }} .bls__media[style*="--bls-ratio"] {
    aspect-ratio: var(--bls-ratio);
  }
  #bls-{{ section.id }} .bls__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #bls-{{ section.id }} .bls__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    max-width: var(--bls-text-max);
    margin-inline-end: auto;
    padding: var(--bls-card-pad);
    text-align: left;
  }
  #bls-{{ section.id }} .bls__card:has(.bls__date) .bls__body {
    padding-bottom: 10px;
  }

  #bls-{{ section.id }} .bls__title {
    margin: 0;
    font-size: var(--bls-title-size);
    line-height: 1.15;
    color: var(--bls-title-color);
  }
  #bls-{{ section.id }} .bls__title a {
    color: inherit;
    text-decoration: none;
  }
  #bls-{{ section.id }} .bls__title a:hover { text-decoration: underline; }

  #bls-{{ section.id }} .bls__excerpt {
    margin: 0;
    color: var(--bls-excerpt-color);
  }
  #bls-{{ section.id }} .bls__excerpt > :first-child { margin-top: 0; }
  #bls-{{ section.id }} .bls__excerpt > :last-child { margin-bottom: 0; }

  #bls-{{ section.id }} .bls__more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--bls-more-color);
    font-weight: 500;
    text-decoration: none;
  }
  #bls-{{ section.id }} .bls__more:hover { text-decoration: underline; }
  #bls-{{ section.id }} .bls__more svg { flex: none; }

  #bls-{{ section.id }} .bls__date {
    display: block;
    padding: 0 var(--bls-card-pad) var(--bls-card-pad);
    text-align: right;
    font-size: 0.85em;
    color: var(--bls-date-color);
  }

  #bls-{{ section.id }} .bls__empty {
    padding: 24px;
    border: 1px dashed rgb(var(--color-foreground-rgb, 0 0 0) / 0.25);
    text-align: center;
  }

  @media (max-width: 749px) {
    #bls-{{ section.id }} .bls__body { max-width: 100%; }
    #bls-{{ section.id }} .bls__title { font-size: calc(var(--bls-title-size) * 0.8); }
  }
{%- endstyle -%}

<div class="section section--{{ s.section_width }} spacing-style" style="{% render 'spacing-style', settings: s %}">
  <div id="bls-{{ section.id }}" class="bls-wrap">
    {%- if s.heading != blank -%}
      <h2 class="bls__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if articles.size > 0 -%}
      <div class="bls">
        {%- for article in articles limit: s.post_limit -%}
          <article class="bls__card">
            {%- if article.image != blank -%}
              <a
                class="bls__media"
                href="{{ article.url }}"
                aria-hidden="true"
                tabindex="-1"
                {% if ratio != blank %}style="--bls-ratio: {{ ratio }};"{% endif %}
              >
                {{
                  article.image
                  | image_url: width: 1600
                  | image_tag:
                    class: 'bls__img',
                    loading: 'lazy',
                    sizes: '100vw',
                    widths: '400, 600, 800, 1000, 1200, 1600, 2000',
                    alt: article.title
                }}
              </a>
            {%- endif -%}

            <div class="bls__body">
              <h3 class="bls__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>

              {%- if s.show_excerpt -%}
                {%- assign excerpt = article.excerpt_or_content | strip_html | truncatewords: s.excerpt_words -%}
                {%- if excerpt != blank -%}
                  <p class="bls__excerpt">{{ excerpt }}</p>
                {%- endif -%}
              {%- endif -%}

              {%- if s.read_more_label != blank -%}
                <a class="bls__more" href="{{ article.url }}">
                  {{ s.read_more_label }}
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                    <path d="M1 8h12M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              {%- endif -%}
            </div>

            {%- if s.show_date and article.published_at -%}
              <time class="bls__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: s.date_format }}
              </time>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="bls__empty">Select a blog in the section settings to show posts here.</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog list — stacked",
  "tag": "section",
  "class": "section-blog-list-stacked",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "info": "Optional."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts to show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },

    { "type": "header", "content": "Card" },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "placeholder": "Transparent"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Text padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text column width",
      "info": "Narrower values keep the title / excerpt / Read More in a column against the left edge.",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "side_gap",
      "label": "Side margin",
      "info": "Space on the left/right of each card. Left at 0, it auto-expands just enough for the card shadow to show on all sides. Set a value to override.",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    { "type": "header", "content": "Card shadow" },
    {
      "type": "checkbox",
      "id": "shadow_enabled",
      "label": "Enable shadow",
      "default": false
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow colour",
      "default": "#000000",
      "visible_if": "{{ section.settings.shadow_enabled }}"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 15,
      "visible_if": "{{ section.settings.shadow_enabled }}"
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Shadow blur",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ section.settings.shadow_enabled }}"
    },
    {
      "type": "range",
      "id": "shadow_spread",
      "label": "Shadow spread",
      "min": -20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.shadow_enabled }}"
    },
    {
      "type": "range",
      "id": "shadow_x",
      "label": "Shadow offset — horizontal",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.shadow_enabled }}"
    },
    {
      "type": "range",
      "id": "shadow_y",
      "label": "Shadow offset — vertical",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.shadow_enabled }}"
    },

    { "type": "header", "content": "Header image" },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image shape",
      "options": [
        { "value": "3 / 1", "label": "Ultrawide banner (3:1)" },
        { "value": "21 / 9", "label": "Cinematic (21:9)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Standard (4:3)" },
        { "value": "auto", "label": "Original image ratio" }
      ],
      "default": "16 / 9"
    },

    { "type": "header", "content": "Title" },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title colour",
      "placeholder": "Theme default"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size (desktop)",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 30
    },

    { "type": "header", "content": "Excerpt" },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "label": "Excerpt length (words)",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 30,
      "visible_if": "{{ section.settings.show_excerpt }}"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt colour",
      "placeholder": "Theme default",
      "visible_if": "{{ section.settings.show_excerpt }}"
    },

    { "type": "header", "content": "Read More link" },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Label",
      "info": "Leave blank to hide.",
      "default": "Read More"
    },
    {
      "type": "color",
      "id": "read_more_color",
      "label": "Link colour",
      "placeholder": "Theme default"
    },

    { "type": "header", "content": "Publish date" },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "select",
      "id": "date_format",
      "label": "Date format",
      "options": [
        { "value": "%B %-d, %Y", "label": "August 5, 2026" },
        { "value": "%b %-d, %Y", "label": "Aug 5, 2026" },
        { "value": "%-d %B %Y", "label": "5 August 2026" },
        { "value": "%m/%d/%Y", "label": "08/05/2026" },
        { "value": "%Y-%m-%d", "label": "2026-08-05" }
      ],
      "default": "%B %-d, %Y",
      "visible_if": "{{ section.settings.show_date }}"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date colour",
      "placeholder": "Theme default",
      "visible_if": "{{ section.settings.show_date }}"
    },

    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Blog list — stacked",
      "category": "Blog"
    }
  ]
}
{% endschema %}
